# ────────────────────────────────────────────────────────────────────
# WhatsApp Notifications (Twilio)
# ────────────────────────────────────────────────────────────────────
# Docs: https://www.twilio.com/docs/whatsapp
# Console: https://console.twilio.com
# ────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ── Mode ─────────────────────────────────────────────────────────────
# "sandbox" → Twilio sandbox number, free-form messages, no template approval needed
# "live"    → Approved Meta/WhatsApp Business number, must use approved templates
TWILIO_MODE=sandbox

# ── Sender numbers ───────────────────────────────────────────────────
# Sandbox: Twilio's shared sandbox number (always this for sandbox mode)
TWILIO_WA_FROM=whatsapp:+14155238886

# Live: your approved WhatsApp Business number (request via Twilio console)
TWILIO_WA_FROM_LIVE=whatsapp:+91XXXXXXXXXX

# ── Admin recipient ──────────────────────────────────────────────────
# Admin's WhatsApp — receives a full order alert on every new order
TWILIO_WA_TO=whatsapp:+916374139363

# ── Content API templates (required for live outbound notifications) ─
# WhatsApp Business Policy requires pre-approved message templates for
# any message sent OUTSIDE a 24-hour customer service window.
#
# HOW TO CREATE:
#   1. Go to: https://console.twilio.com/us1/develop/sms/content-template-builder
#   2. Create a new template (category: UTILITY or TRANSACTIONAL)
#   3. Example customer confirmation template body:
#      "Hi {{1}}, your order #{{2}} for ₹{{3}} has been confirmed!
#       We'll dispatch it soon. Thank you for shopping with Petrichor Naturals 🌿"
#   4. Submit for Meta approval (takes 1–3 business days)
#   5. Copy the Content SID (starts with HX...) and paste below
#
# TWILIO_CUSTOMER_SID  → customer order confirmation template
# TWILIO_CONTENT_SID   → fallback / admin template (or shared template for both)
# Leave blank to use free-form body text (sandbox only / 24h window in live mode)
TWILIO_CUSTOMER_SID=
TWILIO_CONTENT_SID=


# ─── Cloudinary (product image uploads) ───────────────────────────
# Sign up free at https://cloudinary.com, then copy from Dashboard
# Leave blank to use local disk storage (development only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
